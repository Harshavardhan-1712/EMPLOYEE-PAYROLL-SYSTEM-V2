# Copy to .env (never commit .env). All keys use the PV2_ prefix.
PV2_ENV=development                 # development | production
PV2_DATABASE_PATH=data/payroll_v2.db  # must NOT point at V1's employee_data.db
PV2_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
PV2_SESSION_MINUTES=480
PV2_COOKIE_SECURE=false             # must be true in production (HTTPS)
PV2_CORS_ORIGINS=http://localhost:5173   # comma separated; the real frontend origin only
PV2_COMPANY_NAME=HArsha's PVT LTD.
PV2_COMPANY_ADDRESS=
PV2_DEFAULT_OVERTIME_RATE=200       # INR per hour; seeded as the initial setting, then editable in the app
PV2_LOGIN_MAX_FAILURES=5
PV2_LOGIN_WINDOW_SECONDS=900
PV2_MAX_BODY_BYTES=2097152          # request bodies larger than this get HTTP 413
