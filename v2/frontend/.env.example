# Dev only: where the Vite dev/preview server proxies /api (FastAPI).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Optional: absolute API base for deployments where the API is on another origin
# (then PV2_CORS_ORIGINS on the backend must list this app's origin, and cookies need SameSite/secure review).
# VITE_API_BASE=
